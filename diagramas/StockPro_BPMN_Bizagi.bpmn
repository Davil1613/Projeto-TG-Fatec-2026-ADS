<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_stockpro" targetNamespace="http://stockpro.fatec/bpmn" exporter="Claude Code" exporterVersion="1.0"><bpmn:error id="err_movement" name="Movimentação recusada" errorCode="MOVEMENT_REJECTED"/><bpmn:collaboration id="collab_stockpro"><bpmn:participant id="participant_stockpro" name="StockPro" processRef="proc_movimentacao"/></bpmn:collaboration><bpmn:process id="proc_movimentacao" name="Movimentação de estoque" isExecutable="false"><bpmn:laneSet id="laneset"><bpmn:lane id="lane_user" name="Usuário"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_login</bpmn:flowNodeRef><bpmn:flowNodeRef>t_open</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fill</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_ui" name="Interface Web (React)"><bpmn:flowNodeRef>t_validate_ui</bpmn:flowNodeRef><bpmn:flowNodeRef>g_ui</bpmn:flowNodeRef><bpmn:flowNodeRef>t_send</bpmn:flowNodeRef><bpmn:flowNodeRef>t_done</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_api" name="Servidor (API + PostgreSQL)"><bpmn:flowNodeRef>t_auth</bpmn:flowNodeRef><bpmn:flowNodeRef>t_lock</bpmn:flowNodeRef><bpmn:flowNodeRef>g_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>g_type</bpmn:flowNodeRef><bpmn:flowNodeRef>t_in</bpmn:flowNodeRef><bpmn:flowNodeRef>g_stock</bpmn:flowNodeRef><bpmn:flowNodeRef>t_out</bpmn:flowNodeRef><bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef><bpmn:flowNodeRef>t_commit</bpmn:flowNodeRef><bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef><bpmn:flowNodeRef>t_rollback</bpmn:flowNodeRef><bpmn:flowNodeRef>end_err</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Início"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="t_login" name="Autenticar-se no sistema"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="t_open" name="Abrir Nova Movimentação"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="t_fill" name="Selecionar tipo, produto e quantidade"><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_validate_ui" name="Validar campos e saldo exibido"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="g_ui" name="Dados válidos?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_send" name="Enviar requisição POST /movements"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_auth" name="Validar token, perfil e assinatura; iniciar transação"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_lock" name="Bloquear e ler o produto (SELECT ... FOR UPDATE)"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="g_valid" name="Produto e quantidade válidos?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="g_type" name="Tipo?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_in" name="Somar quantidade ao saldo"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="g_stock" name="Saldo suficiente?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_out" name="Subtrair quantidade do saldo"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="g_merge" name=""><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_commit" name="Gravar movimentação e confirmar (COMMIT)"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_audit" name="Registrar log de auditoria"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_done" name="Exibir confirmação e atualizar histórico"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="end_ok" name="Movimentação registrada"><bpmn:incoming>f22</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="t_rollback" name="Desfazer transação (ROLLBACK)"><bpmn:incoming>f12</bpmn:incoming><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="end_err" name="Movimentação recusada"><bpmn:incoming>f23</bpmn:incoming><bpmn:errorEventDefinition id="err_def" errorRef="err_movement"/></bpmn:endEvent><bpmn:sequenceFlow id="f1" name="" sourceRef="start" targetRef="t_login"/><bpmn:sequenceFlow id="f2" name="" sourceRef="t_login" targetRef="t_open"/><bpmn:sequenceFlow id="f3" name="" sourceRef="t_open" targetRef="t_fill"/><bpmn:sequenceFlow id="f4" name="" sourceRef="t_fill" targetRef="t_validate_ui"/><bpmn:sequenceFlow id="f5" name="" sourceRef="t_validate_ui" targetRef="g_ui"/><bpmn:sequenceFlow id="f6" name="sim" sourceRef="g_ui" targetRef="t_send"/><bpmn:sequenceFlow id="f7" name="não (aviso na tela)" sourceRef="g_ui" targetRef="t_fill"/><bpmn:sequenceFlow id="f8" name="" sourceRef="t_send" targetRef="t_auth"/><bpmn:sequenceFlow id="f9" name="" sourceRef="t_auth" targetRef="t_lock"/><bpmn:sequenceFlow id="f10" name="" sourceRef="t_lock" targetRef="g_valid"/><bpmn:sequenceFlow id="f11" name="sim" sourceRef="g_valid" targetRef="g_type"/><bpmn:sequenceFlow id="f12" name="não" sourceRef="g_valid" targetRef="t_rollback"/><bpmn:sequenceFlow id="f13" name="entrada" sourceRef="g_type" targetRef="t_in"/><bpmn:sequenceFlow id="f14" name="saída" sourceRef="g_type" targetRef="g_stock"/><bpmn:sequenceFlow id="f15" name="sim" sourceRef="g_stock" targetRef="t_out"/><bpmn:sequenceFlow id="f16" name="não" sourceRef="g_stock" targetRef="t_rollback"/><bpmn:sequenceFlow id="f17" name="" sourceRef="t_in" targetRef="g_merge"/><bpmn:sequenceFlow id="f18" name="" sourceRef="t_out" targetRef="g_merge"/><bpmn:sequenceFlow id="f19" name="" sourceRef="g_merge" targetRef="t_commit"/><bpmn:sequenceFlow id="f20" name="" sourceRef="t_commit" targetRef="t_audit"/><bpmn:sequenceFlow id="f21" name="" sourceRef="t_audit" targetRef="t_done"/><bpmn:sequenceFlow id="f22" name="" sourceRef="t_done" targetRef="end_ok"/><bpmn:sequenceFlow id="f23" name="" sourceRef="t_rollback" targetRef="end_err"/><bpmn:textAnnotation id="ann1"><bpmn:text>A interface exibe a mensagem retornada pela API (ex.: "Estoque insuficiente. Disponível: 3 unidade(s).")</bpmn:text></bpmn:textAnnotation><bpmn:association id="as_ann1" sourceRef="ann1" targetRef="end_err"/><bpmn:textAnnotation id="ann2"><bpmn:text>Baixas simultâneas aguardam a liberação da linha (RN010)</bpmn:text></bpmn:textAnnotation><bpmn:association id="as_ann2" sourceRef="ann2" targetRef="t_lock"/></bpmn:process><bpmndi:BPMNDiagram id="diagram_stockpro" name="Movimentação de estoque"><bpmndi:BPMNPlane id="plane_stockpro" bpmnElement="collab_stockpro"><bpmndi:BPMNShape id="pool_di" bpmnElement="participant_stockpro" isHorizontal="true"><dc:Bounds x="0" y="100" width="2360" height="770"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_user_di" bpmnElement="lane_user" isHorizontal="true"><dc:Bounds x="36" y="100" width="2324" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_ui_di" bpmnElement="lane_ui" isHorizontal="true"><dc:Bounds x="36" y="270" width="2324" height="200"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_api_di" bpmnElement="lane_api" isHorizontal="true"><dc:Bounds x="36" y="470" width="2324" height="400"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="112" y="167" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_login_di" bpmnElement="t_login"><dc:Bounds x="190" y="155.0" width="150" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_open_di" bpmnElement="t_open"><dc:Bounds x="380" y="155.0" width="150" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_fill_di" bpmnElement="t_fill"><dc:Bounds x="570" y="155.0" width="180" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_validate_ui_di" bpmnElement="t_validate_ui"><dc:Bounds x="570" y="340.0" width="180" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_ui_di" bpmnElement="g_ui" isMarkerVisible="true"><dc:Bounds x="775" y="345" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_send_di" bpmnElement="t_send"><dc:Bounds x="880" y="340.0" width="160" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_auth_di" bpmnElement="t_auth"><dc:Bounds x="875" y="550.0" width="170" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_lock_di" bpmnElement="t_lock"><dc:Bounds x="1085" y="550.0" width="180" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_valid_di" bpmnElement="g_valid" isMarkerVisible="true"><dc:Bounds x="1300" y="555" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_type_di" bpmnElement="g_type" isMarkerVisible="true"><dc:Bounds x="1410" y="555" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_in_di" bpmnElement="t_in"><dc:Bounds x="1515" y="490.0" width="150" height="56"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_stock_di" bpmnElement="g_stock" isMarkerVisible="true"><dc:Bounds x="1530" y="665" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_out_di" bpmnEleme